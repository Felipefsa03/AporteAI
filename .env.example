APP_NAME=AporteAI
APP_ENV=local
# APP_KEY is injected from APORTEAI_RUNTIME_ENV; never fill it in the repository.
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=/tmp/opencode/aporteai-env-socket
DB_PORT=55432
DB_DATABASE=aporteai
DB_USERNAME=aporteai
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=array
SESSION_DRIVER=array

QUEUE_CONNECTION=database
WHATSAPP_QUEUE=whatsapp
# Commercial flags stay false in config/pilot.php; no agent may enable them.
PILOT_ENABLED=false

# Login do proprietário: preencher apenas em ambiente autorizado; nunca versionar valores reais.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
SMS_DRIVER=log
OWNER_MFA_PHONE=

# Para SMS real via Twilio: SMS_DRIVER=twilio e preencher abaixo no ambiente (nunca versionar).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
